# Deny by default. Re-exclude each directory's children before allowing inputs.
**
!package.json
!package-lock.json

!apps
apps/*
!apps/api
apps/api/*
!apps/api/package.json
!apps/api/tsconfig.json
!apps/api/src

!apps/web
apps/web/*
!apps/web/package.json
!apps/web/tsconfig.json
!apps/web/vite.config.ts
!apps/web/index.html
!apps/web/src

# Safety exclusions also apply inside approved source directories.
**/.env*
**/*.pem
**/*.key
**/*.log
**/*.zip
**/*.tsbuildinfo
**/node_modules
**/dist
**/coverage
**/.git
**/.aws
**/.ssh
**/.localstack*
**/localstack-volume
**/credentials
**/secrets
